GOOGLE_API_KEY=
SUPPORTMASTER_MODEL=gemini-3.5-flash
# Optional comma-separated allow-list for the model picker.
# The default catalog is limited to Gemini 3.5 or newer per hackathon rules.
SUPPORTMASTER_MODELS=gemini-3.5-flash-lite,gemini-3.5-flash,gemini-3.6-flash
# Optional Gemma triage model (bonus integration). Advisory-only ticket
# classification; falls back to a deterministic heuristic when unset/unavailable.
SUPPORTMASTER_TRIAGE_MODEL=gemma-3-27b-it
# Optional: set on Google Cloud to export OTel workflow spans to Cloud Trace
# (requires: pip install opentelemetry-exporter-gcp-trace).
GOOGLE_CLOUD_PROJECT=
